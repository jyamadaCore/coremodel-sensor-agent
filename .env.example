# MASTRA_MODEL selects the model via Mastra's model router using a
# "provider/model" string. Any supported provider works; set MASTRA_MODEL
# and that provider's API key, nothing in the code is provider-specific.
#   openai/gpt-5.5        -> requires OPENAI_API_KEY
#   anthropic/claude-sonnet-5-5 -> requires ANTHROPIC_API_KEY
#   google/gemini-2.5-pro  -> requires GOOGLE_GENERATIVE_AI_API_KEY
MASTRA_MODEL=openai/gpt-5.5
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

COREMODEL_LIBRARY_ROOT=/absolute/path/to/coremodel-library
# Defaults to ./sensor-models (relative to the process cwd) when unset.
COREMODEL_OUTPUT_ROOT=/absolute/path/to/sensor-models
# Optional build command executed inside each generated model directory.
# Passing -DCOREMODEL_DIR exercises the real CoreModel-linked adapter
# executable too, not just the pure unit test target.
# COREMODEL_BUILD_COMMAND=cmake -S . -B build -DCOREMODEL_DIR=$COREMODEL_LIBRARY_ROOT && cmake --build build && ctest --test-dir build --output-on-failure
COREMODEL_BUILD_COMMAND=
